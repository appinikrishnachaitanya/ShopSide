SHOPSIDE_DB=/data/shopside.sqlite3
WEB_ORIGIN=http://localhost:3000
GEMINI_API_KEY=
# Select a model available to your account; no unverified default is supplied.
GEMINI_MODEL=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=

CHANNEL3_API_KEY=

# GCP Vertex AI (default). Standard mode uses ADC and these selectors:
AI_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Or Vertex AI express mode: omit project and use VERTEX_API_KEY (GEMINI_API_KEY also accepted).
VERTEX_API_KEY=
