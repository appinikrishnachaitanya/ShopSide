SHOPSIDE_DB=/data/shopside.sqlite3
WEB_ORIGIN=http://localhost:3000
GEMINI_API_KEY=
# Select a model available to your account; no unverified default is supplied.
GEMINI_MODEL=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=

CHANNEL3_API_KEY=

# GCP Vertex AI (default). Standard mode uses ADC and these selectors:
AI_PROVIDER=vertex-express
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Or Vertex AI express mode: omit project and use VERTEX_API_KEY (GEMINI_API_KEY also accepted).
VERTEX_API_KEY=


# Runtime frontend proxy target (HTTP(S) origin, no path). Configure on web service.
BACKEND_URL=http://127.0.0.1:8000
# API database; omit for local SQLite. Example Cloud SQL Unix socket:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
# Optional for IAM-protected Cloud Run API: audience is the API service URL.
BACKEND_ID_TOKEN_AUDIENCE=
# DATABASE_URL is secret. Set it in Secret Manager; leave empty to use SQLite.
DATABASE_URL=
# Set true when the public frontend uses HTTPS.
COOKIE_SECURE=false

# Development only: expose sanitized Smart Bundle tool activity to room members.
SHOPSIDE_BUNDLE_TRACE=false

# Merchant Portal sandbox tenants. Set unique random tokens (24+ characters),
# and only domains independently verified to belong to those sandbox tenants.
SHOPSIDE_MERCHANT_1_TOKEN=
SHOPSIDE_MERCHANT_1_DOMAIN=
SHOPSIDE_MERCHANT_2_TOKEN=
SHOPSIDE_MERCHANT_2_DOMAIN=
SHOPSIDE_MERCHANT_3_TOKEN=
SHOPSIDE_MERCHANT_3_DOMAIN=
# Cloud Scheduler secret header for POST /api/internal/merchant-jobs/process.
MERCHANT_JOB_TOKEN=
